NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO-HTTPS
NEXT_PUBLIC_MP_PUBLIC_KEY=SUA_CHAVE_PUBLICA_MERCADO_PAGO
MP_ACCESS_TOKEN=SEU_TOKEN_PRIVADO_MERCADO_PAGO
MP_WEBHOOK_SECRET=SEGREDO_DO_WEBHOOK
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_PRIVADA
PAYOUT_HOLD_DAYS=0
PAYOUTS_MODE=off
# E-mails da plataforma pelo Gmail (docs/EMAIL-GMAIL.md). Com SMTP_* preenchido, o Resend é ignorado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=SEU_EMAIL@gmail.com
SMTP_PASSWORD=SENHA_DE_APP_DO_GOOGLE
EMAIL_FROM=Artenós <SEU_EMAIL@gmail.com>
# Opcional: alternativa ao Gmail
RESEND_API_KEY=
CRON_SECRET=SEGREDO_ALEATORIO_PARA_AGENDADOR
# Contato e dados institucionais (aparecem na Central de Ajuda, no rodapé e na Política de Privacidade).
# Enquanto não forem preenchidos, as páginas mostram "a definir".
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
# WhatsApp com DDD, só números (ex.: 17999990000)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_HOURS=segunda a sexta, das 9h às 18h (horário de Brasília)
# Caixa que recebe os chamados (se vazio, usa NEXT_PUBLIC_SUPPORT_EMAIL)
SUPPORT_INBOX_EMAIL=
# Anti-robô opcional (Cloudflare Turnstile) no formulário de contato
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
